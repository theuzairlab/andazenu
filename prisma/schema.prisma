generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
  orders    Order[]
}

model OTPToken {
  id        String   @id @default(uuid())
  email     String
  token     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Product {
  id            String         @id @default(uuid())
  name          String
  description   String
  imageUrl      String?
  stock         Int
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  collection    Collection     @default(MENS)
  discount      Int?
  regularPrice  Int
  sellingPrice  Int
  orderItems    OrderItem[]
  productColors ProductColor[]
  productSizes  ProductSize[]
}

model ProductColor {
  id        String   @id @default(uuid())
  productId String
  color     String
  imageUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductSize {
  id        String   @id @default(uuid())
  productId String
  size      String
  stock     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id          String      @id @default(uuid())
  userId      String
  status      OrderStatus @default(PENDING)
  totalAmount Int
  email       String
  name        String
  phone       String
  address     String
  createdAt   DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id])
  orderItems  OrderItem[]
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  size      String
  price     Int
  color     String?
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

// Website settings model to store configurable site elements
model WebsiteSettings {
  id                String   @id @default("settings") // Only one record will exist
  siteName          String   @default("T-Shirt Store")
  logoUrl           String?
  faviconUrl        String?
  primaryColor      String   @default("#000000")
  secondaryColor    String   @default("#ffffff")
  heroSliderImages  Json?    // Array of image URLs for the main slider
  categoryImages    Json?    // Images for category sections
  footerText        String   @default("© 2023 T-Shirt Store. All rights reserved.")
  contactEmail      String   @default("contact@example.com")
  contactPhone      String   @default("+1234567890")
  socialLinks       Json?    // JSON object with social media links
  updatedAt         DateTime @updatedAt
}

enum Collection {
  MENS
  KIDS
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}
